# Backend (copy to backend/.env)
# Docker Postgres (requires Docker Desktop):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopai?schema=public"
# Prisma local Postgres — run `npx prisma dev` in backend/ FIRST, then paste the URLs it prints:
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
DATABASE_URL=""
JWT_SECRET="change-me-to-a-long-random-secret"
CLIENT_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development

# --- AI (standard hybrid search) ---
# Pipeline: LLM structured intent → numeric slot enrichment → SQL filters → embeddings re-rank
# Chat uses an ordered provider chain (failover). Embeddings are sticky (one vector space).

# Open-source primary (recommended when cloud quota is limited):
#   1) Install https://ollama.com
#   2) ollama pull llama3.2
#   3) ollama pull nomic-embed-text
#   4) Set the Ollama block below, then: npm run ai:embed-products
AI_CHAT_PROVIDERS="ollama,gemini"
AI_EMBEDDING_PROVIDER="ollama"
EMBEDDING_DIMENSIONS=768
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL="llama3.2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Gemini cloud (optional secondary / primary if you prefer):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# If using Gemini embeddings instead:
# AI_CHAT_PROVIDERS="gemini,ollama"
# AI_EMBEDDING_PROVIDER="gemini"
# EMBEDDING_DIMENSIONS=3072

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:4000"
