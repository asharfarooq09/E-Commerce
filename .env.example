# Backend (copy to backend/.env)
# Docker Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopai?schema=public"
# Prisma dev server example (run `npx prisma dev` in backend/):
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DATABASE_URL=""
JWT_SECRET="change-me-to-a-long-random-secret"
CLIENT_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL="http://localhost:4000"
